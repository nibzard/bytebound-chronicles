# Server Configuration
API_PORT=3000
API_HOST=localhost

# Database Configuration
DATABASE_PATH=./data

# AI Configuration (required - get your API keys from the providers)
# You can either set these in .env file OR use environment variables
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Turso Database Configuration (for cloud sync)
# TURSO_URL=your_turso_url_here
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Environment
NODE_ENV=development